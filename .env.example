# ==============================================================================
# AetherAI Environment Configuration Example
# Copy this file to .env (or backend/.env) to configure real cloud AI providers.
# The application runs seamlessly out-of-the-box in Mock Mode without any keys.
# ==============================================================================

# Core Settings
APP_NAME=AetherAI
DEBUG=false
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./aetherai.db
UPLOAD_DIR=./uploads

# Default Provider & Model ('mock', 'gemini', 'groq', 'openai', 'ollama')
DEFAULT_PROVIDER=mock
DEFAULT_MODEL=aether-mock-omni

# ------------------------------------------------------------------------------
# Provider API Credentials (Optional - Mock mode works if left empty)
# ------------------------------------------------------------------------------

# Google Gemini API (Recommended for free tier & multimodal)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# GroqCloud API (Recommended for ultra-fast LPU inference)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI or OpenAI-Compatible API (LocalAI, vLLM, DeepSeek, OpenRouter)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Ollama Local Inference (Optional local models)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# Web Search Providers (Optional)
# ------------------------------------------------------------------------------
# Tavily Search API
TAVILY_API_KEY=

# Brave Search API
BRAVE_API_KEY=

# ------------------------------------------------------------------------------
# RAG & Resource Parameters
# ------------------------------------------------------------------------------
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.25
MAX_CONCURRENT_RESEARCH_TASKS=2
REQUEST_TIMEOUT_SECONDS=60
